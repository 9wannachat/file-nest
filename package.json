{
  "name": "filenest",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Self-hosted file manager on Cloudflare Workers, D1 and R2 with Google sign-in.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "dev:s3": "node scripts/fake-s3.ts",
    "build": "vite build && pnpm --filter @filenest/mcp build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.web-test.json --noEmit && tsc -p tsconfig.node.json --noEmit && pnpm --filter @filenest/mcp typecheck",
    "test": "vitest run --project worker --project web && pnpm --filter @filenest/mcp test",
    "test:worker": "vitest run --project worker",
    "test:web": "vitest run --project web",
    "e2e": "playwright test",
    "e2e:server": "node scripts/e2e-server.mjs",
    "icons": "node scripts/generate-icons.ts",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "mcp:build": "pnpm --filter @filenest/mcp build"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "uqr": "^0.1.3",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "~4.1.12",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "~4.1.12",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.166.0"
  }
}
